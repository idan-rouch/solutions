# Path to 1Password CLI, if not on PATH leave empty
OP_PATH=

# Set to true to avoid calling op (uses fixtures for tests)
OP_MOCK=false

# Okta API settings
OKTA_BASE_URL=https://your-okta-domain.okta.com
OKTA_API_TOKEN=your-okta-api-token
OKTA_SCIM_GROUP_ID=your-okta-scim-group-id

# 1Password SCIM (your SCIM Bridge URL ends with /scim/v2)
# Example: https://scim.mycompany.1password.com/scim/v2
OP_SCIM_BASE_URL=https://your-scim-bridge-url/scim/v2
OP_SCIM_BEARER_TOKEN=your-scim-bearer-token
OP_ACCOUNT=your-1password-account-domain

# (Optional) 1Password Admin API (Service Account)
# Example base: https://api.1password.com   (or your region-specific base if applicable)
OP_ADMIN_BASE_URL=https://api.your-region.1password.com
OP_SERVICE_ACCOUNT_TOKEN=your-op-service-account-token
